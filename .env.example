# Document Intake Assistant - Environment Configuration Example
# Copy this file to .env and configure your values

# LLM Provider: 'mock' (default for local development & testing) or 'gemini'
LLM_PROVIDER=mock

# Google Gemini API Configuration (required only when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Server Configuration
HOST=127.0.0.1
PORT=8000
